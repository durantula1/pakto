# Local development: copy to .env.local, then `pnpm db:up` (Postgres + Mailpit) and `pnpm db:migrate`.
# The server's values live in /opt/pakto/.env and deploy/compose.yml (see docs/deployment-notes.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The app connects as pakto_app, which cannot change the schema; dbmate runs migrations as pakto_owner.
DATABASE_URL=postgres://pakto_app:pakto_dev@127.0.0.1:5432/pakto
DATABASE_SSL=false

# Any long random string; client links are signed with it, so keep it stable (`openssl rand -base64 32`).
PORTAL_LINK_SECRET=
# Bearer token for /api/cron/* (16+ characters)
CRON_SECRET=

# Mailpit catches every email (http://localhost:8025). For real mail: smtp.hostinger.com, 465, info@pakto.net + password.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Pakto <info@pakto.net>
EMAIL_DAILY_LIMIT=1000
SUPPORT_EMAIL=info@pakto.net

# Staff sessions (Better Auth); derived from PORTAL_LINK_SECRET when empty
BETTER_AUTH_SECRET=
# Uploaded files (default .data/files)
FILES_DIR=
