{
	email info@pakto.net
	# The Hostinger firewall lets 443 in only from Cloudflare, so Let's Encrypt cannot reach it: renew over port 80
	# (open to all, it only redirects and answers the HTTP challenge), never with the TLS-ALPN challenge on 443.
	cert_issuer acme {
		disable_tlsalpn_challenge
	}
	# Cloudflare sits in front (docs/deployment-notes.md): the visitor's IP comes in CF-Connecting-IP, trusted only
	# from Cloudflare's ranges (https://www.cloudflare.com/ips/). A direct request keeps its own address.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.pakto.net {
	redir https://pakto.net{uri} permanent
}

pakto.net {
	encode zstd gzip
	# 15 MB attachments (+ a little) and the 10 MB of screenshots from the contact form.
	request_body {
		max_size 20MB
	}
	header {
		# includeSubDomains checked 09.10.2026: the only subdomains are www (https, redirects here) and the Hostinger
		# mail ones (autodiscover, autoconfig), which are read by mail clients, not browsers. Not "preload": that is
		# a promise to browsers' lists that is hard to take back.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3000 {
		# One address, the real visitor's: Cloudflare appends to an X-Forwarded-For the visitor sent, so passing
		# that on would let anyone pick the IP the app's limits count.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		# Server-sent events (/api/live) must not be buffered.
		flush_interval -1
	}
}
