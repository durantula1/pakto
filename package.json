{
  "name": "pakto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "docker compose -f docker-compose.dev.yml --profile tools run --rm migrate",
    "video:studio": "pnpm --filter pakto-video studio",
    "video:render": "pnpm --filter pakto-video render",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && pnpm db:up && pnpm db:migrate",
    "db:new": "docker compose -f docker-compose.dev.yml --profile tools run --rm migrate new",
    "db:seed": "docker compose -f docker-compose.dev.yml exec -T postgres psql -U pakto_owner -d pakto -v ON_ERROR_STOP=1 -q < db/seed.sql",
    "db:pull": "bash scripts/db-pull.sh"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@internationalized/date": "3.12.3",
    "@react-pdf/renderer": "4.6.1",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "next": "16.3.6",
    "nodemailer": "10.0.13",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
